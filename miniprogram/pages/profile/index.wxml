<view style="background-color:#1A1A2E; min-height:100vh; padding:32rpx; padding-bottom:200rpx;">
  <!-- 目标选择 -->
  <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">健身目标</view>
  <view style="display:flex; gap:24rpx; margin-bottom:32rpx;">
    <view style="flex:1; display:flex; flex-direction:column; align-items:center; padding:32rpx 24rpx; background-color:#0F3460; border:2rpx solid {{goal === '减脂' ? '#2ECC71' : '#2A2A4A'}}; border-radius:24rpx; {{goal === '减脂' ? 'background-color:rgba(46,204,113,0.1);' : ''}}" bindtap="onGoalFat">
      <text style="font-size:48rpx; margin-bottom:12rpx;">🔥</text>
      <text style="font-size:34rpx; font-weight:600; color:{{goal === '减脂' ? '#2ECC71' : '#FFFFFF'}}; margin-bottom:4rpx;">减脂</text>
      <text style="font-size:20rpx; color:#6C6C80;">燃烧脂肪</text>
    </view>
    <view style="flex:1; display:flex; flex-direction:column; align-items:center; padding:32rpx 24rpx; background-color:#0F3460; border:2rpx solid {{goal === '增肌' ? '#2ECC71' : '#2A2A4A'}}; border-radius:24rpx; {{goal === '增肌' ? 'background-color:rgba(46,204,113,0.1);' : ''}}" bindtap="onGoalMuscle">
      <text style="font-size:48rpx; margin-bottom:12rpx;">💪</text>
      <text style="font-size:34rpx; font-weight:600; color:{{goal === '增肌' ? '#2ECC71' : '#FFFFFF'}}; margin-bottom:4rpx;">增肌</text>
      <text style="font-size:20rpx; color:#6C6C80;">增长肌肉</text>
    </view>
  </view>

  <!-- 肌群选择 -->
  <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">目标肌群</view>
  <view style="display:grid; grid-template-columns:repeat(4,1fr); gap:16rpx; margin-bottom:32rpx;">
    <view
      wx:for="{{muscles}}" wx:key="*this"
      style="display:flex; align-items:center; justify-content:center; height:72rpx; border-radius:36rpx; font-size:24rpx; {{selectedMuscles.indexOf(item) > -1 ? 'background-color:#2ECC71; color:#FFFFFF; font-weight:500;' : 'background-color:#0F3460; color:#A0A0B8; border:2rpx solid transparent;'}}"
      data-name="{{item}}" bindtap="onToggleMuscle">
      <text>{{item}}</text>
    </view>
  </view>

  <!-- 性别 -->
  <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">性别</view>
  <view style="display:flex; gap:24rpx; margin-bottom:32rpx;">
    <view style="flex:1; display:flex; align-items:center; justify-content:center; height:72rpx; border-radius:36rpx; font-size:28rpx; {{gender === 'male' ? 'border:2rpx solid #2ECC71; color:#2ECC71; background-color:rgba(46,204,113,0.1);' : 'background-color:#0F3460; color:#A0A0B8; border:2rpx solid transparent;'}}" bindtap="onGenderMale">
      <text>♂ 男</text>
    </view>
    <view style="flex:1; display:flex; align-items:center; justify-content:center; height:72rpx; border-radius:36rpx; font-size:28rpx; {{gender === 'female' ? 'border:2rpx solid #2ECC71; color:#2ECC71; background-color:rgba(46,204,113,0.1);' : 'background-color:#0F3460; color:#A0A0B8; border:2rpx solid transparent;'}}" bindtap="onGenderFemale">
      <text>♀ 女</text>
    </view>
  </view>

  <!-- 表单 -->
  <view style="display:flex; flex-direction:column; gap:24rpx; margin-bottom:32rpx;">
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">年龄</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" type="number" placeholder="25" placeholder-style="color:#6C6C80;" value="{{age}}" bindinput="onAgeInput" />
        <text style="font-size:24rpx; color:#6C6C80; margin-left:16rpx;">岁</text>
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">身高</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" type="digit" placeholder="175" placeholder-style="color:#6C6C80;" value="{{height}}" bindinput="onHeightInput" />
        <text style="font-size:24rpx; color:#6C6C80; margin-left:16rpx;">cm</text>
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">体重</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" type="digit" placeholder="70" placeholder-style="color:#6C6C80;" value="{{weight}}" bindinput="onWeightInput" />
        <text style="font-size:24rpx; color:#6C6C80; margin-left:16rpx;">kg</text>
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">目标体重</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" type="digit" placeholder="65" placeholder-style="color:#6C6C80;" value="{{targetWeight}}" bindinput="onTargetWeightInput" />
        <text style="font-size:24rpx; color:#6C6C80; margin-left:16rpx;">kg</text>
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">每周训练</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" type="number" placeholder="3" placeholder-style="color:#6C6C80;" value="{{frequency}}" bindinput="onFrequencyInput" />
        <text style="font-size:24rpx; color:#6C6C80; margin-left:16rpx;">天</text>
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">训练周期</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" type="number" placeholder="28" placeholder-style="color:#6C6C80;" value="{{cycleDays}}" bindinput="onCycleDaysInput" />
        <text style="font-size:24rpx; color:#6C6C80; margin-left:16rpx;">天</text>
      </view>
    </view>
  </view>

  <!-- 定位 -->
  <view style="display:flex; align-items:center; gap:12rpx; padding:24rpx 32rpx; background-color:#16213E; border-radius:16rpx;" bindtap="onGetLocation">
    <text style="font-size:28rpx;">📍</text>
    <text style="font-size:24rpx; color:#3498DB;">获取当前位置</text>
  </view>

  <!-- 保存 -->
  <view style="display:flex; align-items:center; justify-content:center; height:88rpx; background:linear-gradient(135deg,#2ECC71,#27AE60); color:#FFFFFF; font-size:34rpx; font-weight:600; border-radius:44rpx; margin-top:32rpx;" bindtap="onSave">
    <text style="color:#FFFFFF; font-size:34rpx; font-weight:600;">保存资料</text>
  </view>
</view>
