<view style="background-color:#1A1A2E; min-height:100vh; padding:32rpx; padding-bottom:200rpx;">
  <!-- 服务商选择 -->
  <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">选择AI服务商</view>
  <view style="display:flex; flex-wrap:wrap; gap:16rpx; margin-bottom:32rpx;">
    <view
      wx:for="{{providers}}" wx:key="type"
      style="padding:16rpx 32rpx; border-radius:36rpx; font-size:24rpx; {{selectedProvider === item.type ? 'border:2rpx solid #2ECC71; color:#2ECC71; background-color:rgba(46,204,113,0.1);' : 'background-color:#0F3460; color:#A0A0B8; border:2rpx solid transparent;'}}"
      data-type="{{item.type}}" bindtap="onProviderTap">
      <text>{{item.name}}</text>
    </view>
  </view>

  <!-- 配置表单 -->
  <view style="display:flex; flex-direction:column; gap:24rpx; margin-bottom:32rpx;">
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">API地址</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" placeholder="https://api.anthropic.com" placeholder-style="color:#6C6C80;" value="{{baseUrl}}" bindinput="onBaseUrlInput" />
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">API密钥</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" placeholder="sk-..." placeholder-style="color:#6C6C80;" password value="{{apiKey}}" bindinput="onApiKeyInput" />
      </view>
    </view>
    <view style="display:flex; align-items:center; justify-content:space-between;">
      <text style="font-size:28rpx; color:#A0A0B8; width:140rpx;">模型名称</text>
      <view style="flex:1; display:flex; align-items:center; background-color:#0F3460; border-radius:16rpx; padding:0 32rpx; height:88rpx;">
        <input style="flex:1; color:#FFFFFF; font-size:28rpx;" placeholder="claude-sonnet-4-6" placeholder-style="color:#6C6C80;" value="{{modelName}}" bindinput="onModelNameInput" />
      </view>
    </view>
  </view>

  <view style="display:flex; align-items:center; justify-content:center; height:88rpx; background:transparent; color:#2ECC71; font-size:34rpx; font-weight:600; border-radius:44rpx; border:2rpx solid #2ECC71;" bindtap="onTestConnection">
    <text style="color:#2ECC71; font-size:34rpx; font-weight:600;">测试连接</text>
  </view>

  <!-- 测试结果 -->
  <view wx:if="{{testResult}}" style="background-color:#16213E; border-radius:16rpx; padding:24rpx; margin:24rpx 0;">
    <text style="font-size:28rpx; font-weight:500; display:block; margin-bottom:8rpx; color:{{testResult.success ? '#2ECC71' : '#E74C3C'}};">{{testResult.success ? '✓ 连接成功' : '✗ 连接失败'}}</text>
    <text style="font-size:24rpx; color:#A0A0B8; display:block;">{{testResult.message || testResult.error}}</text>
  </view>

  <view style="display:flex; align-items:center; justify-content:center; height:88rpx; background:linear-gradient(135deg,#2ECC71,#27AE60); color:#FFFFFF; font-size:34rpx; font-weight:600; border-radius:44rpx; margin-top:24rpx;" bindtap="onSave">
    <text style="color:#FFFFFF; font-size:34rpx; font-weight:600;">保存设置</text>
  </view>

  <view style="display:flex; justify-content:center; padding:32rpx; margin-top:16rpx;" bindtap="onDeleteConfig">
    <text style="font-size:24rpx; color:#E74C3C;">恢复默认设置</text>
  </view>
</view>
