<view style="background-color:#1A1A2E; min-height:100vh; padding:32rpx; padding-bottom:200rpx;">
  <!-- 加载中 -->
  <view wx:if="{{loading}}" style="display:flex; justify-content:center; padding-top:30vh;">
    <text style="font-size:28rpx; color:#6C6C80;">加载中...</text>
  </view>

  <!-- 无计划 -->
  <view wx:if="{{!loading && !plan}}" style="display:flex; flex-direction:column; align-items:center; padding-top:30vh;">
    <text style="font-size:80rpx; margin-bottom:24rpx;">📋</text>
    <text style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:12rpx;">计划不存在</text>
    <text style="font-size:24rpx; color:#A0A0B8;">返回首页生成计划</text>
  </view>

  <!-- 计划内容 -->
  <view wx:if="{{!loading && plan}}">
    <!-- 周期进度 -->
    <view wx:if="{{plan.plan_data.cycle_day}}" style="background-color:#16213E; border-radius:24rpx; padding:24rpx 32rpx; margin-bottom:24rpx;">
      <view style="display:flex; justify-content:space-between; margin-bottom:12rpx;">
        <text style="font-size:24rpx; color:#A0A0B8;">第{{plan.plan_data.cycle_day || 1}}天/{{plan.plan_data.cycle_total || 28}}天</text>
        <text style="font-size:24rpx; color:#F39C12; font-weight:500;">{{plan.plan_data.intensity === 'heavy' ? '高强度' : plan.plan_data.intensity === 'light' ? '低强度' : '中等强度'}}</text>
      </view>
      <view style="height:12rpx; background-color:#0F3460; border-radius:6rpx; overflow:hidden;">
        <view style="height:100%; background:linear-gradient(135deg,#2ECC71,#27AE60); border-radius:6rpx; width:{{plan.plan_data.cycle_day ? Math.round((plan.plan_data.cycle_day / (plan.plan_data.cycle_total || 28)) * 100) : 0}}%;"></view>
      </view>
    </view>

    <!-- 训练组 -->
    <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">🏋️ 训练计划</view>
    <view wx:for="{{plan.plan_data.workout_groups}}" wx:key="muscle_group" wx:for-item="group" style="background-color:#16213E; border-radius:24rpx; padding:32rpx; margin-bottom:24rpx;">
      <text style="font-size:34rpx; font-weight:600; color:#FFFFFF; display:block; margin-bottom:16rpx;">{{group.muscle_group}}训练</text>
      <view wx:for="{{group.exercises}}" wx:key="name" wx:for-item="ex"
            style="display:flex; align-items:flex-start; background-color:#0F3460; border-radius:16rpx; padding:24rpx; margin-bottom:12rpx; border-left:4rpx solid {{ex.completed ? '#2ECC71' : 'transparent'}}; {{ex.completed ? 'opacity:0.7;' : ''}}">
        <view style="width:40rpx; height:40rpx; border-radius:50%; border:3rpx solid {{ex.completed ? '#2ECC71' : '#6C6C80'}}; {{ex.completed ? 'background-color:#2ECC71;' : ''}} display:flex; align-items:center; justify-content:center; margin-right:24rpx;">
          <text wx:if="{{ex.completed}}" style="font-size:22rpx; color:#FFFFFF;">✓</text>
        </view>
        <view style="flex:1;">
          <text style="font-size:28rpx; font-weight:500; color:#FFFFFF; {{ex.completed ? 'text-decoration:line-through; color:#A0A0B8;' : ''}} display:block; margin-bottom:4rpx;">{{ex.name}}</text>
          <view style="display:flex; flex-wrap:wrap; gap:8rpx;">
            <text style="font-size:20rpx; color:#A0A0B8; background-color:rgba(255,255,255,0.05); padding:2rpx 12rpx; border-radius:8rpx;">{{ex.sets}}组×{{ex.reps}}</text>
            <text style="font-size:20rpx; color:#A0A0B8; background-color:rgba(255,255,255,0.05); padding:2rpx 12rpx; border-radius:8rpx;">休{{ex.rest_seconds}}秒</text>
            <text style="font-size:20rpx; color:#F39C12; background-color:rgba(255,255,255,0.05); padding:2rpx 12rpx; border-radius:8rpx;">~{{ex.calories}}千卡</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 饮食 -->
    <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">🍽️ 饮食计划</view>
    <view wx:if="{{plan.plan_data.meal_plan}}" style="background-color:#16213E; border-radius:24rpx; padding:32rpx; margin-bottom:16rpx;">
      <text style="font-size:28rpx; font-weight:600; color:#FFFFFF; display:block; margin-bottom:8rpx;">早餐 · 07:30</text>
      <text style="font-size:24rpx; color:#A0A0B8; display:block; margin-bottom:4rpx;">{{plan.plan_data.meal_plan.breakfast.self_cook.name}}</text>
      <text style="font-size:24rpx; color:#F39C12;">{{plan.plan_data.meal_plan.breakfast.self_cook.calories}}千卡</text>
    </view>
    <view wx:if="{{plan.plan_data.meal_plan}}" style="background-color:#16213E; border-radius:24rpx; padding:32rpx; margin-bottom:16rpx;">
      <text style="font-size:28rpx; font-weight:600; color:#FFFFFF; display:block; margin-bottom:8rpx;">午餐 · 12:00</text>
      <text style="font-size:24rpx; color:#A0A0B8; display:block; margin-bottom:4rpx;">{{plan.plan_data.meal_plan.lunch.self_cook.name}}</text>
      <text style="font-size:24rpx; color:#F39C12;">{{plan.plan_data.meal_plan.lunch.self_cook.calories}}千卡</text>
    </view>
    <view wx:if="{{plan.plan_data.meal_plan}}" style="background-color:#16213E; border-radius:24rpx; padding:32rpx; margin-bottom:16rpx;">
      <text style="font-size:28rpx; font-weight:600; color:#FFFFFF; display:block; margin-bottom:8rpx;">晚餐 · 18:30</text>
      <text style="font-size:24rpx; color:#A0A0B8; display:block; margin-bottom:4rpx;">{{plan.plan_data.meal_plan.dinner.self_cook.name}}</text>
      <text style="font-size:24rpx; color:#F39C12;">{{plan.plan_data.meal_plan.dinner.self_cook.calories}}千卡</text>
    </view>

    <!-- 热量 -->
    <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">📊 热量摘要</view>
    <view wx:if="{{plan.plan_data.calorie_summary}}" style="display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin-bottom:24rpx;">
      <view style="background-color:#0F3460; border-radius:16rpx; padding:24rpx; text-align:center;">
        <text style="display:block; font-size:40rpx; font-weight:700; color:#2ECC71; margin-bottom:4rpx;">{{plan.plan_data.calorie_summary.total_intake}}</text>
        <text style="font-size:20rpx; color:#6C6C80;">摄入(千卡)</text>
      </view>
      <view style="background-color:#0F3460; border-radius:16rpx; padding:24rpx; text-align:center;">
        <text style="display:block; font-size:40rpx; font-weight:700; color:#F39C12; margin-bottom:4rpx;">{{plan.plan_data.calorie_summary.total_exercise}}</text>
        <text style="font-size:20rpx; color:#6C6C80;">消耗(千卡)</text>
      </view>
      <view style="background-color:#0F3460; border-radius:16rpx; padding:24rpx; text-align:center;">
        <text style="display:block; font-size:40rpx; font-weight:700; color:#3498DB; margin-bottom:4rpx;">{{plan.plan_data.calorie_summary.bmr}}</text>
        <text style="font-size:20rpx; color:#6C6C80;">基础(千卡)</text>
      </view>
      <view style="background-color:#0F3460; border-radius:16rpx; padding:24rpx; text-align:center;">
        <text style="display:block; font-size:40rpx; font-weight:700; color:{{plan.plan_data.calorie_summary.net_calories < 0 ? '#2ECC71' : '#E74C3C'}}; margin-bottom:4rpx;">{{plan.plan_data.calorie_summary.net_calories}}</text>
        <text style="font-size:20rpx; color:#6C6C80;">净值(千卡)</text>
      </view>
    </view>

    <!-- 建议 -->
    <view wx:if="{{plan.plan_data.recommendations && plan.plan_data.recommendations.length}}">
      <view style="font-size:34rpx; font-weight:600; color:#FFFFFF; margin-bottom:24rpx;">💡 建议</view>
      <view style="background-color:#16213E; border-radius:24rpx; padding:32rpx; margin-bottom:24rpx;">
        <view wx:for="{{plan.plan_data.recommendations}}" wx:key="*this" style="display:flex; align-items:flex-start; gap:12rpx; margin-bottom:12rpx;">
          <text style="color:#2ECC71; font-size:28rpx;">•</text>
          <text style="font-size:24rpx; color:#A0A0B8; line-height:1.6; flex:1;">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
