page {
  background-color: #1A1A2E;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 全局工具类 */
.container {
  padding: 32rpx;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom) + 32rpx);
}

.card {
  background-color: #16213E;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 24rpx;
}

.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: linear-gradient(135deg, #2ECC71, #27AE60);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 44rpx;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-outline {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: transparent;
  color: #2ECC71;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: 2rpx solid #2ECC71;
}

.divider {
  height: 1rpx;
  background-color: #1E1E3A;
  margin: 0 32rpx;
}
